# Supabase project configuration (publishable/anon key only; never put a service-role key here).
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Zhipu BigModel CogView-3-Flash image generation API key.
ZHIPU_API_KEY=your_zhipu_api_key

# Optional text-only Arabic-to-English translation (Gemini Flash free tier).
GEMINI_API_KEY=your_google_gemini_api_key
TAVILY_API_KEY=your_tavily_api_key
